{
  "name": "treeti",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy:staging": "node -e \"console.error('This shared environment is now production. Use npm run cf:deploy:production.'); process.exit(1)\"",
    "cf:deploy:production": "opennextjs-cloudflare deploy --config wrangler.promotion.jsonc --env \"\"",
    "setup:check": "tsx --env-file-if-exists=.env.local scripts/check-setup.ts",
    "jobs:check:staging": "node --env-file-if-exists=.env.local scripts/check-hosted-jobs.mjs",
    "predev": "node scripts/build-assets.mjs",
    "prebuild": "node scripts/build-assets.mjs",
    "pretest": "node scripts/build-assets.mjs",
    "pretypecheck": "node scripts/build-assets.mjs",
    "postcf:build": "node scripts/package-worker-manifest.mjs",
    "test:workers": "node scripts/test-workers.mjs",
    "backup:project": "node --env-file-if-exists=.env.local scripts/backup-project.mjs",
    "cf:deploy:promoted": "opennextjs-cloudflare deploy --config wrangler.promotion.jsonc --env \"\"",
    "check:production": "node scripts/check-staging-domain.mjs --production"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@hookform/resolvers": "^5.2.0",
    "@opennextjs/cloudflare": "1.20.9",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-pdf/renderer": "^4.3.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.80.0",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.0",
    "canonicalize": "^2.1.0",
    "clsx": "^2.1.1",
    "inngest": "^3.44.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "resend": "^6.2.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "fast-check": "^4.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "wrangler": "4.149.0"
  }
}
